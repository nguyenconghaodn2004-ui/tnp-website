# ============================================================
# CƠ SỞ DỮ LIỆU ĐỘNG (MONGODB ATLAS CLOUD)
# ============================================================
# Tạo cluster miễn phí tại https://mongodb.com
# Điền chuỗi kết nối vào file .env của bạn (KHÔNG đẩy .env lên GitHub):
# DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tnp_db?retryWrites=true&w=majority
#
# Nếu để trống DATABASE_URL, hệ thống sẽ tự động dùng file JSON cục bộ (data/*.json)
DATABASE_URL=

